<%
// One photo card for the /photography waterfall grid, rendered as static HTML at
// build time. `item` is a Flickr photo record; `index` is its natural (newest-
// first) position so the client "Latest" sort can restore order without data;
// `priority` flags the first few cards for eager/high-priority loading.
var base = 'https://live.staticflickr.com/' + item.server + '/' + item.id + '_' + item.secret;
var imgUrl = item.url_c || (base + '_c.jpg');
// Responsive candidates, capped at the `_c` we always served, so no device
// downloads more than before while a 1x desktop column (~592px) gets the `_z`.
// Flickr's _w/_z/_c are 400/640/800px on the LONGEST edge, so the `w` descriptors
// are scaled from `_c`'s real width (a portrait `_c` is narrower than 800px).
var srcset = '';
if (item.width_c && item.height_c) {
    var cw = +item.width_c, longest = Math.max(cw, +item.height_c);
    var wOf = function(edge) { return Math.round(cw * edge / longest); };
    srcset = base + '_w.jpg ' + wOf(400) + 'w, ' + base + '_z.jpg ' + wOf(640) + 'w, ' + imgUrl + ' ' + cw + 'w';
}
var sizes = '(max-width: 740px) 100vw, (max-width: 1290px) 50vw, 592px';
var link = 'https://www.flickr.com/photos/' + item.owner + '/' + item.id;
// Reserve each card's height before its image loads so the waterfall packs it
// immediately (no reflow), and paint the build-time LQIP (flickr_lqip.json) as
// the card's blurred placeholder — inlined, so it costs no extra request.
var style = '';
if (item.width_c && item.height_c) style += 'aspect-ratio: ' + item.width_c + ' / ' + item.height_c + ';';
if (item.lqip) style += "background-image: url('" + item.lqip + "');";
%>
<div class="grid-item revealed" data-id="<%= item.id %>" data-index="<%= index %>" data-views="<%= item.views || '' %>" data-lat="<%= item.latitude || '' %>" data-lng="<%= item.longitude || '' %>">
    <a href="<%= link %>" target="_blank" rel="noopener">
        <div class="blur-up" style="<%= style %>">
            <img src="<%= imgUrl %>"<% if (srcset) { %> srcset="<%= srcset %>" sizes="<%= sizes %>"<% } %> class="img-large" decoding="async" alt="<%= item.title %>"<% if (priority) { %> fetchpriority="high"<% } else { %> loading="lazy"<% } %> onload="this.parentElement.classList.add('loaded')">
            <div class="photo-title">
                <span class="photo-name"><%= item.title %></span>
                <% if (item.views) { %><span class="photo-views"><i class="icon material-symbols-outlined">visibility</i> <%= item.views %></span><% } %>
            </div>
        </div>
    </a>
</div>
